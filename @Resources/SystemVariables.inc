[Variables]
; ============================================================
;  TornStatus — System Variables (SystemVariables.inc)
;  Wewnetrzne zmienne skina. Ten plik jest ZAWSZE nadpisywany podczas aktualizacji .rmskin.
; ============================================================

SkinVersion=0.1.0
UpdateURL=https://raw.githubusercontent.com/YourUsername/TornStatus/main/version.txt
RepoURL=https://github.com/YourUsername/TornStatus

; Sciezki do pamieci podrecznej (Cache)
UserCacheFile=#@#Cache\user.json
FactionCacheFile=#@#Cache\faction.json

; Stale definicje krojow pisma (Fonty)
FontMono=JetBrains Mono, Consolas, monospace
FontDisplay=Space Grotesk, Segoe UI, sans-serif
FontSans=Geist, Segoe UI, sans-serif

; Stale definicje kolorow paskow statusu
ColorEnergy=124,179,66,255
ColorEnergyBg=104,159,56,40
ColorNerve=208,101,66,255
ColorNerveBg=200,90,50,40
ColorLife=108,153,214,255
ColorLifeBg=63,110,181,40
ColorHappy=209,180,74,255
ColorHappyBg=192,160,48,40
